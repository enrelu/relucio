---
import Layout from '../layouts/Layout.astro';
const booking = 'https://calendar.notion.so/meet/djrelu/30bi4z8a';
---
<Layout wide title="Hablemos de tu negocio | Enrique Relucio" description="Cuéntame qué ocurre en tu actividad comercial y reserva una conversación inicial.">
  <div class="contact-layout">
    <header class="contact-intro"><p class="eyebrow">Conversación inicial</p><h1>Hablemos de tu negocio.</h1><p>Cuéntame qué está pasando en tu actividad comercial y qué te gustaría cambiar. Así podemos empezar la conversación con contexto.</p><div class="contact-alternatives"><a class="text-link" href={booking} target="_blank" rel="noopener noreferrer">Reservar directamente ↗</a><a class="text-link" href="mailto:enrique@relucio.es">enrique@relucio.es</a></div><p class="contact-note">Primero valoramos si tiene sentido trabajar juntos. El alcance y la dedicación se acuerdan después.</p></header>
    <section class="form-panel" aria-label="Formulario de contacto">
      <form id="contact-form" action="https://formsubmit.co/enrique@relucio.es" method="POST">
        <input type="hidden" name="_subject" value="Consulta de dirección comercial desde relucio.es" />
        <input type="hidden" name="_next" value={booking} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <div class="honeypot" aria-hidden="true"><label for="company-fax">Deja este campo vacío</label><input id="company-fax" type="text" name="_honey" tabindex="-1" autocomplete="off" /></div>
        <div class="form-row"><div><label for="name">Nombre</label><input id="name" name="name" type="text" autocomplete="name" maxlength="120" required /></div><div><label for="email">Email profesional</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div></div>
        <div><label for="company">Empresa o web</label><input id="company" name="company" type="text" autocomplete="organization" maxlength="200" required /></div>
        <div><label for="situation">¿Qué está pasando en tu actividad comercial?</label><textarea id="situation" name="situation" rows="4" maxlength="5000" required></textarea></div>
        <div><label for="goal">¿Qué te gustaría cambiar?</label><textarea id="goal" name="goal" rows="3" maxlength="3000" required></textarea></div>
        <p class="form-privacy">Los datos se utilizarán para responder a esta solicitud. El envío se procesa mediante <a href="https://formsubmit.co/" target="_blank" rel="noopener noreferrer">FormSubmit</a>. Para consultas sobre tus datos, escribe a enrique@relucio.es. La reserva se realiza en Notion Calendar.</p>
        <p id="form-error" class="form-error" role="alert" hidden></p>
        <button id="submit-btn" type="submit" class="button button-primary">Enviar y reservar una conversación <span aria-hidden="true">↗</span></button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
      <div id="success-message" class="success-panel" hidden tabindex="-1"><p class="eyebrow">Solicitud enviada</p><h2>Ahora podemos hablar.</h2><p>El formulario se ha enviado. Elige un horario para nuestra conversación inicial.</p><a class="button button-primary" href={booking} target="_blank" rel="noopener noreferrer">Reservar la conversación ↗</a><button id="reset-btn" type="button" class="text-link">Enviar otra consulta</button></div>
    </section>
  </div>
</Layout>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const button = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const success = document.getElementById('success-message');
  const error = document.getElementById('form-error');
  const status = document.getElementById('form-status');
  let sending = false;
  form?.addEventListener('submit', async e => {
    e.preventDefault();
    if (sending || !form || !button || !success || !error || !status || !form.reportValidity()) return;
    const data = new FormData(form);
    if (data.get('_honey')) return;
    sending = true; button.disabled = true; error.hidden = true; status.textContent = 'Enviando tu consulta…';
    form.setAttribute('aria-busy','true');
    const controller = new AbortController();
    const timer = setTimeout(()=>controller.abort(),15000);
    try {
      const response = await fetch('https://formsubmit.co/ajax/enrique@relucio.es',{method:'POST',body:data,headers:{Accept:'application/json'},signal:controller.signal});
      const result = await response.json();
      if (!response.ok || (result.success !== true && result.success !== 'true')) throw new Error('El proveedor no confirmó el envío');
      form.hidden = true; success.hidden = false; success.focus(); form.reset();
    } catch {
      error.textContent = 'No se ha confirmado el envío. Tus datos siguen aquí: puedes reintentar, escribir por correo o reservar directamente.';
      error.hidden = false;
    } finally {
      clearTimeout(timer);sending = false;button.disabled = false;form.setAttribute('aria-busy','false');status.textContent = '';
    }
  });
  document.getElementById('reset-btn')?.addEventListener('click',()=>{
    if (!form || !success || !error) return;
    success.hidden = true;form.hidden = false;error.hidden = true;
    document.getElementById('name')?.focus();
  });
</script>
