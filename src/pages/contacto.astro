---
import Layout from '../layouts/Layout.astro';
const booking = 'https://calendly.com/enriquerelucio/conversacioninicial';
---
<Layout wide title="Hablemos de tu negocio | Enrique Relucio" description="Cuéntame qué ocurre en tu actividad comercial y reserva una conversación inicial.">
  <div id="contact-layout" class="contact-layout">
    <header class="contact-intro"><p class="eyebrow">Conversación inicial · 30 minutos</p><h1>Hablemos de tu negocio.</h1><p>Primero cuéntame qué está pasando en tu actividad comercial y qué te gustaría cambiar. Después elige un horario para hablar.</p><ol class="booking-steps" aria-label="Pasos de la reserva"><li id="context-step" aria-current="step"><span>01</span> Tu negocio</li><li id="time-step"><span>02</span> Elegir horario</li></ol><p class="contact-note">El alcance y la dedicación se acuerdan después de conocer tu situación.</p></header>
    <section id="context-panel" class="form-panel" aria-label="Contexto para la reunión">
      <form id="contact-form" method="POST">
        <div class="form-row"><div><label for="name">Nombre</label><input id="name" name="name" type="text" autocomplete="name" maxlength="120" required /></div><div><label for="email">Email profesional</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div></div>
        <div><label for="company">Empresa o web</label><input id="company" name="company" type="text" autocomplete="organization" maxlength="200" required /></div>
        <div><label for="situation">¿Qué está pasando en tu actividad comercial?</label><textarea id="situation" name="situation" rows="4" maxlength="5000" required></textarea></div>
        <div><label for="goal">¿Qué te gustaría cambiar?</label><textarea id="goal" name="goal" rows="3" maxlength="3000" required></textarea></div>
        <p class="form-privacy">La reserva se completa al confirmar el horario</p>
        <p id="form-error" class="form-error" role="alert" hidden></p>
        <button id="submit-btn" type="submit" class="button button-primary" disabled>Continuar y elegir horario <span aria-hidden="true">→</span></button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
      <noscript><style>#contact-form{display:none}</style><p>Activa JavaScript para completar el formulario y elegir un horario. No se han enviado datos ni se ha reservado ninguna reunión.</p></noscript>
    </section>
    <section id="booking-panel" class="booking-panel" aria-labelledby="booking-title" hidden>
      <div class="booking-heading"><div><p class="eyebrow">Paso 2</p><h2 id="booking-title" tabindex="-1">Elige un horario.</h2><p>Tu contexto ya está rellenado en las notas de Calendly. Revisa los datos y confirma la reserva.</p></div><button id="back-btn" type="button" class="text-link">← Editar mis respuestas</button></div>
      <p id="booking-status" class="form-status" role="status" aria-live="polite">Cargando horarios…</p>
      <div id="calendar-error" class="form-error" role="alert" hidden><p>El calendario está tardando en cargar. Tus respuestas siguen aquí; puedes reintentarlo o volver al formulario.</p><button id="retry-btn" type="button" class="text-link">Reintentar calendario</button></div>
      <div id="calendly-embed" class="calendly-embed" data-booking-url={booking}></div>
    </section>
    <section id="booking-confirmed" class="form-panel booking-confirmed" aria-labelledby="confirmed-title" hidden tabindex="-1"><p class="eyebrow">Reserva confirmada</p><h2 id="confirmed-title">Ya tenemos una conversación.</h2><p>Calendly ha confirmado la reserva. Encontrarás los detalles y las opciones para cambiarla o cancelarla en la confirmación de la reunión.</p><a class="text-link" href="/">Volver al inicio →</a></section>
  </div>
</Layout>
<script>
  export {};
  type CalendlyOptions = { url: string; parentElement: HTMLElement; prefill: { name: string; email: string; customAnswers: { a1: string } } };
  declare global { interface Window { Calendly?: { initInlineWidget: (options: CalendlyOptions) => void } } }
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const button = document.getElementById('submit-btn') as HTMLButtonElement;
  const contextPanel = document.getElementById('context-panel')!;
  const bookingPanel = document.getElementById('booking-panel')!;
  const layout = document.getElementById('contact-layout')!;
  const embed = document.getElementById('calendly-embed')!;
  const error = document.getElementById('form-error')!;
  const status = document.getElementById('form-status')!;
  const calendarError = document.getElementById('calendar-error')!;
  const calendarStatus = document.getElementById('booking-status')!;
  let loading = false;
  let widgetPromise: Promise<void> | null = null;
  let frameTimer: ReturnType<typeof setTimeout> | undefined;
  let prefill: CalendlyOptions['prefill'] | null = null;
  button.disabled = false;
  const controls = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input,textarea'));
  controls.forEach(control => control.addEventListener('input', () => control.setCustomValidity('')));
  function loadWidget(): Promise<void> {
    if (window.Calendly) return Promise.resolve();
    if (widgetPromise) return widgetPromise;
    widgetPromise = new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js'; script.async = true;
      const fail = () => { clearTimeout(timer); script.remove(); widgetPromise = null; reject(new Error('No se pudo cargar Calendly')); };
      const timer = setTimeout(fail, 15000);
      script.onerror = fail;
      script.onload = () => { if (!window.Calendly) { fail(); return; } clearTimeout(timer); resolve(); };
      document.head.append(script);
    });
    return widgetPromise;
  }
  function showCalendar() {
    if (!window.Calendly || !prefill) throw new Error('Calendario no disponible');
    clearTimeout(frameTimer); embed.replaceChildren(); calendarError.hidden = true;
    calendarStatus.textContent = 'Cargando horarios…';
    contextPanel.hidden = true; bookingPanel.hidden = false; layout.classList.add('is-booking');
    document.getElementById('context-step')?.removeAttribute('aria-current');
    document.getElementById('time-step')?.setAttribute('aria-current', 'step');
    window.Calendly.initInlineWidget({ url: embed.dataset.bookingUrl!, parentElement: embed, prefill });
    const frame = embed.querySelector('iframe');
    if (!frame) throw new Error('Calendly no creó el calendario');
    frame.title = 'Elegir horario y confirmar la conversación en Calendly';
    frameTimer = setTimeout(() => { calendarStatus.textContent = ''; calendarError.hidden = false; }, 25000);
    frame.addEventListener('load', () => { clearTimeout(frameTimer); calendarStatus.textContent = ''; calendarError.hidden = true; }, { once: true });
    document.getElementById('booking-title')?.focus();
  }
  function backToForm() {
    clearTimeout(frameTimer); bookingPanel.hidden = true; contextPanel.hidden = false;
    embed.replaceChildren(); layout.classList.remove('is-booking');
    document.getElementById('time-step')?.removeAttribute('aria-current');
    document.getElementById('context-step')?.setAttribute('aria-current', 'step');
  }
  form.addEventListener('submit', async event => {
    event.preventDefault(); if (loading) return;
    controls.forEach(control => control.setCustomValidity(control.value.trim() ? '' : 'Completa este campo.'));
    if (!form.reportValidity()) return;
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement).value.trim();
    // a1 corresponde al campo de notas (primera pregunta) del evento actual.
    prefill = { name: value('name'), email: value('email'), customAnswers: { a1: `Empresa o web:\n${value('company')}\n\nSituación comercial:\n${value('situation')}\n\nQué le gustaría cambiar:\n${value('goal')}` } };
    loading = true; button.disabled = true; error.hidden = true; status.textContent = 'Preparando el calendario…';
    form.setAttribute('aria-busy','true');
    try { await loadWidget(); showCalendar(); }
    catch { backToForm(); error.textContent = 'No se ha podido cargar el calendario. Tus respuestas siguen aquí. Vuelve a pulsar Continuar para reintentarlo.'; error.hidden = false; }
    finally { loading = false; button.disabled = false; status.textContent = ''; form.setAttribute('aria-busy','false'); }
  });
  document.getElementById('back-btn')?.addEventListener('click', () => { backToForm(); document.getElementById('name')?.focus(); });
  document.getElementById('retry-btn')?.addEventListener('click', () => { try { showCalendar(); } catch { backToForm(); error.hidden = false; error.textContent = 'No se ha podido cargar el calendario. Puedes volver a intentarlo sin perder tus respuestas.'; } });
  window.addEventListener('message', event => {
    const frame = embed.querySelector('iframe');
    if (bookingPanel.hidden || !frame || event.origin !== 'https://calendly.com' || event.source !== frame.contentWindow) return;
    const data = event.data;
    if (data?.event !== 'calendly.event_scheduled' || typeof data.payload?.event?.uri !== 'string' || !/^https:\/\/api\.calendly\.com\/scheduled_events\/[a-zA-Z0-9-]+$/.test(data.payload.event.uri)) return;
    clearTimeout(frameTimer); bookingPanel.hidden = true; embed.replaceChildren(); prefill = null; form.reset();
    const confirmed = document.getElementById('booking-confirmed')!; confirmed.hidden = false; confirmed.focus();
    document.getElementById('time-step')?.removeAttribute('aria-current');
  });
</script>
