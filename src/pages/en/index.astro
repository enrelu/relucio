---
import Layout from '../../layouts/Layout.astro';
const steps = [
  {
    title: "Understand how you sell",
    text: "We review what you offer, who you sell to, where opportunities come from, and what happens from the first conversation through to the proposal and the sale.",
    practice: "We work with real examples: open opportunities, proposals you have sent, and the information you use today.",
    outcome: "An assessment and clear priorities for improvement.",
  },
  {
    title: "Organize and coach",
    text: "We define which opportunities to pursue, how to follow up, who takes ownership, and what information you need to make decisions.",
    practice: "We work through real situations with you and your team, so you understand the reasoning and know how to apply it.",
    outcome: "A clear way of working that everyone shares.",
  },
  {
    title: "Get you ready to put it into practice",
    text: "We set up the tools to put that approach into practice: opportunities, tasks, next steps and sales reviews.",
    practice: "We use them in your actual day-to-day work and adjust anything that proves complicated or unnecessary.",
    outcome: "Practical tools and a guide to using them.",
  },
];
const deliverables = [
  ["Priorities", "What to improve first and what can wait."],
  ["A method", "How to manage opportunities, responsibilities and follow-up."],
  ["Tools", "A structure for recording, carrying out and reviewing the work."],
  ["Shared understanding", "A team that understands how to use it and what it is for."],
];
const fields = [
  ["Opportunity", "What you sell and to whom."],
  ["Status", "Where it stands."],
  ["Next action", "The next step."],
  ["Responsible", "Who does it."],
  ["Date", "When to do it."],
];
const signals = [
  "Opportunities depend on each person's memory.",
  "Proposals are sent, but follow-up is irregular.",
  "The team uses different criteria.",
  "Too many sales decisions end up with the founder.",
];
const references = [
  {company:'Alcorce',text:"Built and led the cybersecurity business unit.",metric:"+600%",context:"Year-over-year growth."},
  {company:'ALTEN',text:"Built the Telco business unit and developed key accounts.",metric:"€2.5M",context:"The unit’s annual account portfolio."},
  {company:'Babel',text:"Led the business and sales team in the Levante region.",metric:"4 salespeople",context:"Team established and led in the Levante region."},
];
---
<Layout wide title="Enrique Relucio | Sales consulting for B2B technology companies" description="I bring structure to your sales: we assess how you sell, define a way of working and set up the tools to put it into practice.">
  <div class="framework-landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Sales consulting · B2B technology companies</p>
        <h1 id="hero-title">I bring structure to your sales.</h1>
        <p class="hero-description">I assess how you sell, work with you to find a better way of doing it, and give you the tools to put it into practice every day.</p>
        <div class="hero-actions"><a class="button button-primary" href="/en/contact/">Let’s talk about your business <span aria-hidden="true">↗</span></a><a class="text-link" href="#metodo">See how I work ↓</a></div>
      </div>
      <figure class="hero-scheme framework-scheme" aria-labelledby="scheme-title">
        <figcaption id="scheme-title">From analysis to day-to-day work.</figcaption>
        <ol class="commercial-cycle">
          <li><span class="cycle-number" aria-hidden="true">01</span><div><strong>Understand</strong><p>Assessment</p></div></li>
          <li><span class="cycle-number" aria-hidden="true">02</span><div><strong>Organize</strong><p>Working approach</p></div></li>
          <li><span class="cycle-number" aria-hidden="true">03</span><div><strong>Put into practice</strong><p>Tools</p></div></li>
        </ol>
      </figure>
    </section>

    <section id="metodo" class="section-block" aria-labelledby="method-title">
      <div class="section-heading"><p class="eyebrow">How I work</p><h2 id="method-title">First, we look at what is happening.<br />Then we change how you work.</h2></div>
      <ol class="method-grid framework-method">
        {steps.map((step,i)=><li><span class="small-index">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p><p class="method-practice">{step.practice}</p><div class="method-outcome"><span>What you take away</span><p>{step.outcome}</p></div></li>)}
      </ol>
    </section>

    <section id="oferta" class="section-block" aria-labelledby="offer-title">
      <div class="section-heading"><p class="eyebrow">From analysis to daily work</p><h2 id="offer-title">What your business takes away.</h2></div>
      <dl class="framework-deliverables">{deliverables.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
      <div class="framework-tool-demo">
        <figure class="tool-sample" aria-labelledby="tool-title"><figcaption id="tool-title"><strong>Opportunity tracking</strong><span>Example structure</span></figcaption><dl class="tool-fields">{fields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></figure>
        <aside class="review-guide" aria-labelledby="review-title"><h3 id="review-title">A review with specific questions.</h3><ul><li>What has moved forward?</li><li>What is blocked?</li><li>What decision is needed?</li><li>Who takes the next step?</li></ul></aside>
      </div>
    </section>

    <section class="section-block framework-fit" aria-labelledby="fit-title">
      <div class="section-heading"><p class="eyebrow">Who it is for</p><h2 id="fit-title">For businesses that already sell, but rely too much on improvisation.</h2><p>I work with B2B technology companies that already have customers and people who can put the changes into practice.</p></div>
      <div><p class="fit-list-label">It makes sense if:</p><ul class="fit-signals">{signals.map(signal=><li>{signal}</li>)}</ul></div>
    </section>

    <section id="experiencia" class="section-block" aria-labelledby="experience-title">
      <div class="section-heading"><p class="eyebrow">Experience</p><h2 id="experience-title">I have led businesses,<br />not just designed processes.</h2><p>I have built and led business units in telecommunications and cybersecurity, with responsibility for services, customers, teams and results.</p></div>
      <div class="framework-references">{references.map(item=><article><h3>{item.company}</h3><p>{item.text}</p>{'metric' in item && <div class="reference-metric"><strong>{item.metric}</strong><span>{item.context}</span></div>}</article>)}</div>
      <a class="text-link section-link" href="/en/about/#trayectoria">See my experience and projects →</a>
    </section>

    <section class="closing-cta" aria-labelledby="contact-title"><p class="eyebrow">Next step</p><h2 id="contact-title">Tell me how you sell today.</h2><p>What you offer, who handles sales, and where things get stuck. In our first conversation, we will see whether I can help and where it makes sense to start.</p><a class="button button-primary" href="/en/contact/">Let’s talk about your business <span aria-hidden="true">↗</span></a></section>
  </div>
</Layout>
