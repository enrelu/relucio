---
import Layout from '../layouts/Layout.astro';
import ExpandableItem from '../components/ExpandableItem.astro';
import FlickrPhoto from '../components/FlickrPhoto.astro';
import { experience, certifications, projects } from '../data/portfolio';
const skills = [
  {
    title: "Desarrollo de Negocio",
    description: "Creación y escalado de unidades de negocio, gestión de ofertas complejas y negociación estratégica de alto nivel."
  },
  {
    title: "Gestión de Licitaciones",
    description: "Experiencia sólida en la redacción técnica, defensa y gestión integral de RFPs y pliegos para el sector público (Bid Management)."
  },
  {
    title: "Consultoría de Ciberseguridad",
    description: "Profundo conocimiento del estado del arte y vendors. Capacidad para prescribir arquitecturas y traducir necesidades técnicas en valor de negocio."
  },
  {
    title: "Project Management",
    description: "Dirección de equipos multidisciplinares y supervisión financiera de la ejecución para garantizar el margen del proyecto."
  }
];
const metrics = [
  {value:'+150',label:'Proyectos liderados'},
  {value:'+60',label:'Clientes gestionados'},
  {value:'+10 M€',label:'Volumen de negocio'},
  {value:'+50',label:'Equipo de ingenieros'},
];
const sections = [{id:'perfil',label:'Perfil'},{id:'trayectoria',label:'Trayectoria'},{id:'proyectos',label:'Proyectos'},{id:'certificaciones',label:'Certificaciones'},{id:'fotografia',label:'Fotografía'}];
---
<Layout title="Sobre mí y CV | Enrique Relucio" description="Perfil, experiencia profesional, proyectos y certificaciones de Enrique Relucio. Creación y dirección de unidades de negocio.">
  <div class="profile-page">
    <header class="profile-heading">
      <img src="/sobre_mi.jpg" alt="Enrique Relucio" width="144" height="144" />
      <div><p class="eyebrow">Sobre mí</p><h1>Enrique Relucio</h1><p class="profile-subtitle">Ingeniero de Telecomunicación · Desarrollo de negocio · Consultoría estratégica</p></div>
    </header>
    <nav class="profile-tabs" aria-label="Secciones de mi perfil">
      {sections.map(section=><a id={`tab-${section.id}`} href={`#${section.id}`} data-profile-tab={section.id}>{section.label}</a>)}
    </nav>
    <section id="perfil" class="profile-panel" data-profile-panel aria-labelledby="tab-perfil">
      <div class="profile-section-heading"><p class="eyebrow">Perfil profesional</p><h2>Creación y dirección de negocio.</h2></div>
      <div class="profile-bio">
        <p>
          Cuento con ocho años de experiencia impulsando el crecimiento de negocio en el sector tecnológico, tanto en el ámbito corporativo como en el público (B2B/B2G). Mi trayectoria se define por la capacidad de <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">transformar capacidades técnicas en unidades de negocio rentables</strong>.
        </p>
        <p>
          He liderado la creación de nuevas líneas de actividad desde su planificación estratégica hasta su maduración financiera. Mi gestión abarca el ciclo completo: definición de portfolio, servitización, captación de clientes clave y responsabilidad sobre la cuenta de resultados (P&L).
        </p>
      </div>
      <div class="profile-metrics">{metrics.map(metric=><article><strong>{metric.value}</strong><p>{metric.label}</p></article>)}</div>
      <h2>Competencias clave</h2><p class="profile-lead">Más allá de la venta, aporto una visión integral de ingeniería:</p>
      <div class="profile-skills">{skills.map(skill=><article><h3>{skill.title}</h3><p>{skill.description}</p></article>)}</div>
      <p class="profile-product-note">También desarrollo <a href="https://fidusos.com" target="_blank" rel="noopener noreferrer">Fidus OS ↗</a>, un producto propio de gestión y seguimiento comercial. Es independiente de este servicio.</p>
    </section>
    <section id="trayectoria" class="profile-panel" data-profile-panel aria-labelledby="tab-trayectoria">
      <div class="profile-section-heading"><p class="eyebrow">Experiencia profesional</p><h2>Trayectoria</h2><p>El recorrido que respalda mi trabajo en dirección comercial y desarrollo de negocio.</p></div>
      {experience.map(job=><ExpandableItem id={job.id} title={job.role} subtitle={job.company} summary={job.summary} details={job.details} year={job.year} />)}
    </section>
    <section id="proyectos" class="profile-panel" data-profile-panel aria-labelledby="tab-proyectos">
      <div class="profile-section-heading"><p class="eyebrow">Productos y casos profesionales</p><h2>Proyectos</h2></div>
      <h3 class="profile-group-title">Productos y proyectos personales</h3>
      {projects.filter(p=>p.category==='desarrollo').map(p=><ExpandableItem id={p.id} title={p.title} subtitle={p.client} summary={p.summary} details={p.details} year={p.year} url={'url' in p?p.url:undefined} />)}
      <h3 class="profile-group-title">Proyectos de ciberseguridad</h3><p class="profile-lead">Casos profesionales del ámbito de ciberseguridad, separados de la oferta actual de dirección comercial.</p>
      {projects.filter(p=>p.category==='consultoria').map(p=><ExpandableItem id={p.id} title={p.title} subtitle={p.client} summary={p.summary} details={p.details} year={p.year} />)}
    </section>
    <section id="certificaciones" class="profile-panel" data-profile-panel aria-labelledby="tab-certificaciones">
      <div class="profile-section-heading"><p class="eyebrow">Formación acreditada</p><h2>Certificaciones</h2></div>
      <div class="cert-grid profile-certifications">{certifications.map(cert=>{
        const Tag = 'url' in cert ? 'a' : 'article';
        return <Tag class="profile-certification" href={'url' in cert ? cert.url : undefined} target={'url' in cert ? '_blank' : undefined} rel={'url' in cert ? 'noopener noreferrer' : undefined}>
          <div class="certification-title"><h3>{cert.name}</h3><div class="certification-meta">{'url' in cert && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-label="Ver credencial"><path d="M14 4h6v6m0-6L10 14M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" /></svg>}<span>{cert.year}</span></div></div>
          <p>Emitido por <strong>{cert.issuer}</strong></p>
        </Tag>;
      })}</div>
    </section>
    <section id="fotografia" class="profile-panel" data-profile-panel aria-labelledby="tab-fotografia"><FlickrPhoto /></section>
  </div>
</Layout>
<script>
  document.querySelector('.profile-page')?.classList.add('is-enhanced');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-profile-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-profile-panel]'));
  document.querySelector('.profile-tabs')?.setAttribute('role', 'tablist');
  tabs.forEach(tab => { tab.setAttribute('role','tab'); tab.setAttribute('aria-controls',tab.dataset.profileTab!); });
  panels.forEach(panel => panel.setAttribute('role','tabpanel'));
  function activate(id: string, focus = false) {
    tabs.forEach(tab => {const active=tab.dataset.profileTab===id; tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;if(active&&focus)tab.focus();});
    panels.forEach(panel=>{panel.hidden=panel.id!==id;panel.tabIndex=panel.hidden?-1:0;});
    window.dispatchEvent(new CustomEvent('profile-section-change', {detail:id}));
  }
  function readHash() {
    const id=location.hash.slice(1);
    const target=document.getElementById(id);
    const panel=panels.find(panel=>panel.id===id||!!target&&panel.contains(target));
    activate(panel?.id||'perfil');
    if(target instanceof HTMLDetailsElement)target.open=true;
  }
  tabs.forEach((tab,index)=>{
    tab.addEventListener('click',e=>{e.preventDefault();history.pushState(null,'','#'+tab.dataset.profileTab);activate(tab.dataset.profileTab!);});
    tab.addEventListener('keydown',e=>{
      let next=index;
      if(e.key==='ArrowRight')next=(index+1)%tabs.length;
      else if(e.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;
      else if(e.key==='Home')next=0;
      else if(e.key==='End')next=tabs.length-1;
      else return;
      e.preventDefault();const id=tabs[next].dataset.profileTab!;history.replaceState(null,'','#'+id);activate(id,true);
    });
  });
  window.addEventListener('hashchange',readHash);window.addEventListener('popstate',readHash);readHash();
  let closed: HTMLDetailsElement[]=[];
  let hiddenPanels: HTMLElement[]=[];
  window.addEventListener('beforeprint',()=>{hiddenPanels=panels.filter(panel=>panel.hidden);panels.forEach(panel=>panel.hidden=false);closed=Array.from(document.querySelectorAll<HTMLDetailsElement>('.profile-page .portfolio-item:not([open])'));closed.forEach(detail=>detail.open=true);});
  window.addEventListener('afterprint',()=>{closed.forEach(detail=>detail.open=false);closed=[];hiddenPanels.forEach(panel=>panel.hidden=true);hiddenPanels=[];});
</script>
