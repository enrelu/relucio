---
import Layout from '../layouts/Layout.astro';
const steps = [
  {
    title: 'Entender cómo vendes',
    text: 'Revisamos qué ofreces, a quién, cómo llegan las oportunidades y qué ocurre desde el primer contacto hasta la propuesta y el cierre.',
    practice: 'Trabajamos con ejemplos reales: oportunidades abiertas, propuestas enviadas y la información que utilizáis hoy.',
    outcome: 'Un diagnóstico y unas prioridades de mejora.',
  },
  {
    title: 'Ordenar y enseñar',
    text: 'Definimos qué oportunidades atender, cómo hacer seguimiento, quién se responsabiliza y qué información necesitas para decidir.',
    practice: 'Lo trabajamos contigo y con tu equipo sobre situaciones reales, para que entendáis el criterio y sepáis aplicarlo.',
    outcome: 'Una forma de trabajar clara y compartida.',
  },
  {
    title: 'Prepararte para ejecutarlo',
    text: 'Configuramos las herramientas necesarias para llevar ese método a la práctica: oportunidades, tareas, próximos pasos y revisión comercial.',
    practice: 'Las usamos con vuestro trabajo real y ajustamos lo que resulte complicado o innecesario.',
    outcome: 'Herramientas de trabajo y una guía para utilizarlas.',
  },
];
const deliverables = [
  ['Prioridades', 'Qué mejorar primero y qué puede esperar.'],
  ['Un método', 'Cómo gestionar oportunidades, responsabilidades y seguimiento.'],
  ['Herramientas', 'Una estructura para registrar, ejecutar y revisar el trabajo.'],
  ['Criterio compartido', 'Un equipo que entiende cómo utilizarlo y para qué.'],
];
const fields = [
  ['Oportunidad', 'Qué vendes y a quién.'],
  ['Estado', 'En qué punto está.'],
  ['Próxima acción', 'El siguiente paso.'],
  ['Responsable', 'Quién lo hace.'],
  ['Fecha', 'Cuándo hacerlo.'],
];
const signals = [
  'Las oportunidades dependen de la memoria de cada persona.',
  'Se envían propuestas, pero el seguimiento es irregular.',
  'El equipo utiliza criterios distintos.',
  'Demasiadas decisiones comerciales terminan en el fundador.',
];
const references = [
  {company:'Alcorce',text:'Creación y dirección de la unidad de ciberseguridad.'},
  {company:'ALTEN',text:'Creación de la unidad Telco y desarrollo de grandes cuentas.',metric:'2,5 M€',context:'Cartera anual de la unidad.'},
  {company:'Babel',text:'Dirección del negocio y del equipo comercial de Levante.',metric:'4 comerciales',context:'Equipo establecido y dirigido en Levante.'},
];
---
<Layout wide title="Enrique Relucio | Consultoría comercial para empresas tecnológicas B2B" description="Pongo orden en tu actividad comercial: analizo cómo vendes, definimos una forma de trabajar y configuramos herramientas para ejecutarla.">
  <div class="framework-landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Consultoría comercial · Empresas tecnológicas B2B</p>
        <h1 id="hero-title">Pongo orden en tu actividad comercial.</h1>
        <p class="hero-description">Analizo cómo vendes, trabajo contigo para definir una forma de hacerlo mejor y te doy herramientas para llevarla al día a día.</p>
        <div class="hero-actions"><a class="button button-primary" href="/contacto">Hablemos de tu negocio <span aria-hidden="true">↗</span></a><a class="text-link" href="#metodo">Ver cómo trabajo ↓</a></div>
      </div>
      <figure class="hero-scheme framework-scheme" aria-labelledby="scheme-title">
        <figcaption id="scheme-title">Cómo pasamos del análisis al trabajo diario.</figcaption>
        <ol class="commercial-cycle">
          <li><span class="cycle-number" aria-hidden="true">01</span><div><strong>Entender</strong><p>Diagnóstico</p></div></li>
          <li><span class="cycle-number" aria-hidden="true">02</span><div><strong>Ordenar</strong><p>Método de trabajo</p></div></li>
          <li><span class="cycle-number" aria-hidden="true">03</span><div><strong>Poner en práctica</strong><p>Herramientas</p></div></li>
        </ol>
      </figure>
    </section>

    <section id="metodo" class="section-block" aria-labelledby="method-title">
      <div class="section-heading"><p class="eyebrow">Cómo trabajo</p><h2 id="method-title">Primero vemos qué ocurre.<br />Después cambiamos cómo trabajas.</h2></div>
      <ol class="method-grid framework-method">
        {steps.map((step,i)=><li><span class="small-index">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p><p class="method-practice">{step.practice}</p><div class="method-outcome"><span>Qué sale de aquí</span><p>{step.outcome}</p></div></li>)}
      </ol>
    </section>

    <section id="oferta" class="section-block" aria-labelledby="offer-title">
      <div class="section-heading"><p class="eyebrow">Del análisis al trabajo diario</p><h2 id="offer-title">Qué queda en tu empresa.</h2></div>
      <dl class="framework-deliverables">{deliverables.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
      <div class="framework-tool-demo">
        <figure class="tool-sample" aria-labelledby="tool-title"><figcaption id="tool-title"><strong>Seguimiento de oportunidades</strong><span>Ejemplo de estructura</span></figcaption><dl class="tool-fields">{fields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></figure>
        <aside class="review-guide" aria-labelledby="review-title"><h3 id="review-title">Una revisión con preguntas concretas.</h3><ul><li>¿Qué ha avanzado?</li><li>¿Qué está bloqueado?</li><li>¿Qué decisión hace falta?</li><li>¿Quién hace el siguiente movimiento?</li></ul></aside>
      </div>
    </section>

    <section class="section-block framework-fit" aria-labelledby="fit-title">
      <div class="section-heading"><p class="eyebrow">Para quién</p><h2 id="fit-title">Para empresas que ya venden, pero trabajan con demasiada improvisación.</h2><p>Trabajo con empresas tecnológicas B2B que ya tienen clientes y personas que pueden ejecutar los cambios.</p></div>
      <div><p class="fit-list-label">Tiene sentido si:</p><ul class="fit-signals">{signals.map(signal=><li>{signal}</li>)}</ul></div>
    </section>

    <section id="experiencia" class="section-block" aria-labelledby="experience-title">
      <div class="section-heading"><p class="eyebrow">Experiencia</p><h2 id="experience-title">He dirigido negocio,<br />no solo diseñado procesos.</h2><p>He creado y dirigido unidades de negocio en telecomunicaciones y ciberseguridad, con responsabilidad sobre oferta, clientes, equipos y resultados.</p></div>
      <div class="framework-references">{references.map(item=><article><h3>{item.company}</h3><p>{item.text}</p>{'metric' in item && <div class="reference-metric"><strong>{item.metric}</strong><span>{item.context}</span></div>}</article>)}</div>
      <a class="text-link section-link" href="/sobre-mi#trayectoria">Ver trayectoria y proyectos →</a>
    </section>

    <section class="closing-cta" aria-labelledby="contact-title"><p class="eyebrow">Siguiente paso</p><h2 id="contact-title">Cuéntame cómo estás vendiendo hoy.</h2><p>Qué ofreces, quién se ocupa de vender y dónde se atasca el trabajo. En la conversación inicial veremos si puedo ayudarte y por dónde tendría sentido empezar.</p><a class="button button-primary" href="/contacto">Hablemos de tu negocio <span aria-hidden="true">↗</span></a></section>
  </div>
</Layout>
