---
import Layout from '../layouts/Layout.astro';
const responsibilities = [
  ['Pipeline y prioridades', 'Revisión de oportunidades y criterios para concentrar el esfuerzo comercial.'],
  ['Cadencia comercial', 'Reuniones útiles, próximos pasos y seguimiento de compromisos.'],
  ['Dirección del equipo', 'Responsabilidades claras, acompañamiento y coordinación con el negocio.'],
  ['Métricas para decidir', 'Indicadores que permitan revisar avances y tomar decisiones con contexto.'],
];
const cases = [
  { company: 'Alcorce', period: '2022 · Actualidad', title: 'Creación de una unidad de ciberseguridad', text: 'Definición de la oferta, acuerdos con fabricantes y mayoristas, dirección comercial y responsabilidad sobre P&L.', metric: '+600%', detail: 'Crecimiento de facturación en 2025. +200% en 2024, tras el lanzamiento de la unidad en 2023.' },
  { company: 'ALTEN Spain', period: '2018 · 2021', title: 'Creación y dirección de una unidad Telco', text: 'Apertura de cuentas, desarrollo de la oferta, dirección del equipo y gestión de márgenes y rentabilidad.', metric: '2,5 M€', detail: 'Cartera anual. Más de 35 ingenieros y crecimiento de facturación del +170% en 2019.' },
  { company: 'Babel', period: '2021 · 2022', title: 'Dirección del negocio en Levante', text: 'Gestión del negocio de ciberseguridad y acompañamiento a clientes en sus planes de seguridad.', metric: '1 M€', detail: 'Cartera de clientes. Crecimiento interanual del +20% en 2021 y del +10% en 2022.' },
];
---
<Layout wide title="Enrique Relucio | Dirección comercial para empresas tecnológicas B2B" description="Dirección comercial fraccional para CEOs y fundadores de empresas tecnológicas B2B. Pipeline, prioridades, equipo y métricas.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Dirección comercial · Empresas tecnológicas B2B</p>
      <h1 id="hero-title">Dirección comercial para que las oportunidades tengan seguimiento y el equipo tenga prioridades.</h1>
      <p class="hero-description">Acompañamiento a CEOs y fundadores para dirigir el pipeline, establecer métricas y dar al equipo una cadencia de trabajo.</p>
      <div class="hero-actions"><a class="button button-primary" href="/contacto">Hablemos de tu negocio <span aria-hidden="true">↗</span></a><a class="text-link" href="#experiencia">Ver mi experiencia ↓</a></div>
      <p class="hero-note">Un proyecto de puesta en marcha o dirección comercial fraccional, según lo que necesite tu negocio.</p>
    </div>
    <figure class="hero-scheme" aria-labelledby="scheme-title">
      <figcaption id="scheme-title">De la oportunidad a la decisión.</figcaption>
      <ol class="commercial-cycle">
        <li><span class="cycle-number" aria-hidden="true">01</span><div><strong>Oportunidades</strong><p>Qué merece atención.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">02</span><div><strong>Prioridades</strong><p>Dónde concentrar el esfuerzo.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">03</span><div><strong>Seguimiento</strong><p>Qué avanza y qué se atasca.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">04</span><div><strong>Decisiones</strong><p>Qué mantener y qué cambiar.</p></div></li>
      </ol>
    </figure>
  </section>

  <section class="section-block problem-section" aria-labelledby="problems-title">
    <div class="section-heading"><p class="eyebrow">Cuándo tiene sentido</p><h2 id="problems-title">Hay oportunidades y hay equipo.<br />Falta una forma de dirigir la venta.</h2></div>
    <div class="two-columns">
      <article><span class="small-index">01</span><h3>Oportunidades que pierden seguimiento</h3><p>Reuniones, propuestas y contactos que avanzan sin una próxima acción clara. Cuesta saber qué está pendiente y dónde intervenir.</p></article>
      <article><span class="small-index">02</span><h3>Actividad sin prioridades compartidas</h3><p>El equipo trabaja, pero faltan decisiones sobre qué oportunidades atender, quién se responsabiliza y cómo medir el avance.</p></article>
    </div>
  </section>

  <section id="oferta" class="section-block" aria-labelledby="offer-title">
    <div class="section-heading"><p class="eyebrow">Qué ofrezco</p><h2 id="offer-title">Dirección y acompañamiento<br />para tu actividad comercial.</h2><p>Trabajo contigo y con tu equipo sobre cuatro áreas.</p></div>
    <div class="responsibilities">{responsibilities.map(([title,text],i)=><article><span class="small-index">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
  </section>

  <section id="metodo" class="section-block" aria-labelledby="method-title">
    <div class="section-heading"><p class="eyebrow">Cómo trabajo</p><h2 id="method-title">Primero entendemos el negocio.<br />Después acordamos cómo dirigirlo.</h2></div>
    <ol class="method-grid">
      <li><span class="small-index">01</span><h3>Entender la situación</h3><p>Conversación con el CEO y revisión del equipo, las oportunidades y la forma de trabajar.</p></li>
      <li><span class="small-index">02</span><h3>Acordar prioridades</h3><p>Definición del alcance, las responsabilidades, las métricas y la cadencia de dirección.</p></li>
      <li><span class="small-index">03</span><h3>Acompañar y revisar</h3><p>Dirección recurrente, seguimiento de oportunidades y ajustes a partir de lo que ocurre.</p></li>
    </ol>
    <div class="engagement-grid">
      <article><p class="eyebrow">Proyecto de arranque</p><h3>Puesta en marcha</h3><p>Diagnóstico y establecimiento de una forma de dirección comercial: prioridades, responsabilidades, reuniones y métricas.</p></article>
      <article><p class="eyebrow">Acompañamiento recurrente</p><h3>Dirección comercial fraccional</h3><p>Trabajo con el CEO y el equipo para sostener esa forma de trabajar y tomar decisiones. Dedicación y alcance acordados con cada empresa.</p></article>
    </div>
  </section>

  <section id="experiencia" class="section-block" aria-labelledby="experience-title">
    <div class="section-heading"><p class="eyebrow">Por qué trabajar conmigo</p><h2 id="experience-title">Experiencia construyendo<br />y dirigiendo negocio.</h2><p>Responsabilidades desempeñadas dentro de estas empresas.</p></div>
    <div class="case-grid">{cases.map(item=><article class="case-card"><div class="case-top"><strong>{item.company}</strong><span>{item.period}</span></div><h3>{item.title}</h3><p>{item.text}</p><div class="case-result"><strong>{item.metric}</strong><p>{item.detail}</p></div></article>)}</div>
    <a class="text-link section-link" href="/sobre-mi#trayectoria">Ver trayectoria y certificaciones →</a>
  </section>

  <section class="section-block about-strip" aria-labelledby="about-title"><div><p class="eyebrow">Sobre mí</p><h2 id="about-title">Ingeniero de Telecomunicación.<br />Mi trabajo es construir negocio.</h2></div><div><p>He creado y dirigido unidades de negocio en telecomunicaciones y ciberseguridad, con responsabilidad sobre oferta, cuentas, equipos y resultados.</p><a class="text-link" href="/sobre-mi">Conocer mi trayectoria →</a><p class="product-note">También desarrollo <a href="https://fidusos.com" target="_blank" rel="noopener noreferrer">Fidus OS ↗</a>, un producto propio de gestión y seguimiento comercial. Es independiente de este servicio.</p></div></section>

  <section class="closing-cta" aria-labelledby="contact-title"><p class="eyebrow">Siguiente paso</p><h2 id="contact-title">Hablemos de tu negocio.</h2><p>Cuéntame qué está pasando en tu actividad comercial y qué te gustaría cambiar. Después podemos reservar una conversación.</p><a class="button button-primary" href="/contacto">Contar mi situación y reservar <span aria-hidden="true">↗</span></a></section>
</Layout>
