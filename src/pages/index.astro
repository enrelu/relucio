---
import Layout from '../layouts/Layout.astro';
const responsibilities = [
  ['Prioridades comerciales', 'Decidir qué clientes y oportunidades merecen atención y dónde concentrar el esfuerzo.'],
  ['Oferta y oportunidades', 'Revisar qué se propone, a quién y con qué criterios de valor y rentabilidad.'],
  ['Dirección del equipo', 'Acordar responsabilidades, acompañar al equipo y desbloquear decisiones.'],
  ['Seguimiento y resultados', 'Revisar avances, próximos pasos e indicadores para corregir a tiempo.'],
];
const cases = [
  { company: 'Alcorce', title: 'Creación de una unidad de ciberseguridad', text: 'Definición de la oferta, acuerdos con fabricantes y mayoristas, dirección comercial y responsabilidad sobre P&L.', metric: '+600%', detail: 'Crecimiento de facturación en 2025. +200% en 2024, tras el lanzamiento de la unidad en 2023.' },
  { company: 'ALTEN Spain', title: 'Creación y dirección de una unidad Telco', text: 'Apertura de cuentas, desarrollo de la oferta, dirección del equipo y gestión de márgenes y rentabilidad.', metric: '2,5 M€', detail: 'Cartera anual. Más de 35 ingenieros y crecimiento de facturación del +170% en 2019.' },
  { company: 'Babel', title: 'Dirección del negocio en Levante', text: 'Gestión del negocio de ciberseguridad y acompañamiento a clientes en sus planes de seguridad.', metric: '1 M€', detail: 'Cartera de clientes. Crecimiento interanual del +20% en 2021 y del +10% en 2022.' },
];
---
<Layout wide title="Enrique Relucio | Dirección comercial para empresas tecnológicas B2B" description="Dirección comercial externa para empresas tecnológicas B2B que ya venden. Prioridades, equipo y oportunidades para CEOs y fundadores.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Dirección comercial · Empresas tecnológicas B2B</p>
      <h1 id="hero-title">Tu empresa ya vende. Ahora necesita dirección comercial.</h1>
      <p class="hero-description">Trabajo con CEOs y fundadores que siguen asumiendo la dirección comercial de su empresa. Definimos prioridades, dirigimos al equipo y revisamos las oportunidades para que cada decisión no tenga que pasar por ti.</p>
      <div class="hero-actions"><a class="button button-primary" href="/contacto">Hablemos de tu negocio <span aria-hidden="true">↗</span></a><a class="text-link" href="#experiencia">Ver mi experiencia ↓</a></div>
      <p class="hero-note">Un proyecto inicial para ordenar la actividad comercial o dirección externa con dedicación acordada.</p>
    </div>
    <figure class="hero-scheme" aria-labelledby="scheme-title">
      <figcaption id="scheme-title">De la oportunidad a la decisión.</figcaption>
      <ol class="commercial-cycle">
        <li><span class="cycle-number" aria-hidden="true">01</span><div><strong>Oportunidades</strong><p>Qué merece atención.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">02</span><div><strong>Prioridades</strong><p>Dónde concentrar el esfuerzo.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">03</span><div><strong>Seguimiento</strong><p>Qué avanza y qué se atasca.</p></div></li>
        <li><span class="cycle-number" aria-hidden="true">04</span><div><strong>Decisiones</strong><p>Qué mantener y qué cambiar.</p></div></li>
      </ol>
    </figure>
  </section>

  <section class="section-block problem-section" aria-labelledby="problems-title">
    <div class="section-heading"><p class="eyebrow">Cuándo tiene sentido</p><h2 id="problems-title">Hay oportunidades y hay equipo.<br />Falta una forma de dirigir la venta.</h2><p>Trabajo con empresas de servicios tecnológicos que ya tienen clientes y personas dedicadas a la actividad comercial, pero necesitan reforzar su dirección.</p><p class="fit-sectors">Ciberseguridad, cloud, telecomunicaciones e integración tecnológica son ámbitos que conozco.</p></div>
    <div class="two-columns">
      <article><span class="small-index">01</span><h3>Oportunidades que pierden seguimiento</h3><p>Reuniones, propuestas y contactos que avanzan sin una próxima acción clara. Cuesta saber qué está pendiente y dónde intervenir.</p></article>
      <article><span class="small-index">02</span><h3>Actividad sin prioridades compartidas</h3><p>El equipo trabaja, pero faltan decisiones sobre qué oportunidades atender, quién se responsabiliza y cómo medir el avance.</p></article>
      <article><span class="small-index">03</span><h3>La venta sigue dependiendo de ti</h3><p>El equipo puede avanzar, pero las prioridades, las propuestas y las decisiones importantes vuelven siempre al CEO. Dirigir la actividad comercial ocupa el tiempo que necesitas para dirigir la empresa.</p></article>
    </div>
  </section>

  <section id="oferta" class="section-block" aria-labelledby="offer-title">
    <div class="section-heading"><p class="eyebrow">Qué ofrezco</p><h2 id="offer-title">Dirección y acompañamiento<br />para tu actividad comercial.</h2><p>Trabajo contigo y con tu equipo sobre cuatro áreas.</p></div>
    <div class="responsibilities">{responsibilities.map(([title,text],i)=><article><span class="small-index">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
  </section>

  <section id="metodo" class="section-block" aria-labelledby="method-title">
    <div class="section-heading"><p class="eyebrow">Cómo trabajo</p><h2 id="method-title">Primero entendemos el negocio.<br />Después acordamos cómo dirigirlo.</h2></div>
    <ol class="method-grid">
      <li><span class="small-index">01</span><h3>Entender la situación</h3><p>Conversación con el CEO y revisión del equipo, las oportunidades y la forma de trabajar.</p></li>
      <li><span class="small-index">02</span><h3>Acordar prioridades</h3><p>Definición del alcance, las responsabilidades, las métricas y la cadencia de dirección.</p></li>
      <li><span class="small-index">03</span><h3>Acompañar y revisar</h3><p>Dirección recurrente, seguimiento de oportunidades y ajustes a partir de lo que ocurre.</p></li>
    </ol>
    <div class="engagement-grid">
      <article><p class="eyebrow">Proyecto inicial</p><h3>Ordenar la actividad comercial</h3><p>Revisamos la situación y dejamos definidas las prioridades, las responsabilidades y una forma de seguimiento que el equipo pueda mantener.</p></article>
      <article><p class="eyebrow">Dirección comercial externa</p><h3>Dirigir y dar continuidad</h3><p>Asumo contigo la dirección comercial: prioridades, acompañamiento al equipo, revisión de oportunidades y decisiones. Con una dedicación acordada, sin incorporar todavía ese puesto a tiempo completo.</p></article>
    </div>
  </section>

  <section id="experiencia" class="section-block" aria-labelledby="experience-title">
    <div class="section-heading"><p class="eyebrow">Por qué trabajar conmigo</p><h2 id="experience-title">Experiencia dirigiendo<br />negocio tecnológico.</h2><p>He creado y dirigido unidades de negocio con responsabilidad sobre oferta, clientes, equipos y resultados. Esta experiencia es la base de mi trabajo con empresas tecnológicas B2B.</p><p class="experience-context">Responsabilidades desempeñadas dentro de estas empresas.</p></div>
    <div class="case-grid">{cases.map(item=><article class="case-card"><div class="case-top"><strong>{item.company}</strong></div><h3>{item.title}</h3><p>{item.text}</p><div class="case-result"><strong>{item.metric}</strong><p>{item.detail}</p></div></article>)}</div>
    <a class="text-link section-link" href="/sobre-mi#trayectoria">Ver trayectoria y certificaciones →</a>
  </section>

  <section class="section-block about-strip" aria-labelledby="about-title"><div><p class="eyebrow">Sobre mí</p><h2 id="about-title">Ingeniero de Telecomunicación.<br />Mi trabajo es construir negocio.</h2></div><div><p>He creado y dirigido unidades de negocio en telecomunicaciones y ciberseguridad, con responsabilidad sobre oferta, cuentas, equipos y resultados.</p><a class="text-link" href="/sobre-mi">Conocer mi trayectoria →</a><p class="product-note">También desarrollo <a href="https://fidusos.com" target="_blank" rel="noopener noreferrer">Fidus OS ↗</a>, un producto propio de gestión y seguimiento comercial. Es independiente de este servicio.</p></div></section>

  <section class="closing-cta" aria-labelledby="contact-title"><p class="eyebrow">Siguiente paso</p><h2 id="contact-title">Hablemos de tu negocio.</h2><p>Cuéntame qué está pasando en tu actividad comercial y qué te gustaría cambiar.</p><a class="button button-primary" href="/contacto">Contar mi situación y reservar <span aria-hidden="true">↗</span></a></section>
</Layout>
