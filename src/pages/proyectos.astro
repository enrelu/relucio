---
import Layout from '../layouts/Layout.astro';
import ExpandableItem from '../components/ExpandableItem.astro';
import { projects } from '../data/portfolio';
---
<Layout title="Proyectos | Enrique Relucio" description="Productos propios y proyectos profesionales de Enrique Relucio.">
  <header class="archive-heading"><p class="eyebrow">Más allá del servicio</p><h1>Productos propios y proyectos.</h1><p>Una selección del trabajo de desarrollo y ciberseguridad que forma parte de mi recorrido.</p></header>
  <section id="personales"><h2>Productos y proyectos personales</h2>{projects.filter(p=>p.category==='desarrollo').map(p=><ExpandableItem id={p.id} title={p.title} subtitle={p.client} summary={p.summary} details={p.details} year={p.year} url={'url' in p?p.url:undefined} />)}</section>
  <section class="section-block" id="profesionales"><h2>Proyectos de ciberseguridad</h2><p class="mb-6">Casos profesionales del ámbito de ciberseguridad, separados de la oferta actual de dirección comercial.</p>{projects.filter(p=>p.category==='consultoria').map(p=><ExpandableItem id={p.id} title={p.title} subtitle={p.client} summary={p.summary} details={p.details} year={p.year} />)}</section>
</Layout>
