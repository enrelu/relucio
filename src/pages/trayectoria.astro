---
import Layout from '../layouts/Layout.astro';
import ExpandableItem from '../components/ExpandableItem.astro';
import { experience, certifications } from '../data/portfolio';
---
<Layout title="Trayectoria y CV | Enrique Relucio" description="Experiencia en creación y dirección de unidades de negocio, telecomunicaciones y ciberseguridad.">
  <header class="archive-heading"><p class="eyebrow">Trayectoria profesional</p><h1>Experiencia y certificaciones.</h1><p>El recorrido que respalda mi trabajo en dirección comercial y desarrollo de negocio.</p></header>
  <section id="experiencia" aria-label="Experiencia profesional">{experience.map(job=><ExpandableItem id={job.id} title={job.role} subtitle={job.company} summary={job.summary} details={job.details} year={job.year} />)}</section>
  <section id="certificaciones" class="section-block"><h2>Certificaciones</h2><div class="cert-grid">{certifications.map(cert=><article><h3>{cert.name}</h3><p>{cert.issuer} · {cert.year}</p>{'url' in cert && <a class="text-link" href={cert.url} target="_blank" rel="noopener noreferrer">Ver credencial ↗</a>}</article>)}</div></section>
  <div class="archive-actions"><button class="button button-secondary" type="button" onclick="window.print()">Imprimir o guardar como PDF</button><a class="text-link" href="/contacto">Hablemos de tu negocio →</a></div>
</Layout>
<style is:global>@media print { .site-header,.site-footer,.archive-actions,button { display:none!important; } details { display:block; } .site-main { max-width:none;padding:0; } }</style>
<script>
  let closed:HTMLDetailsElement[]=[];
  window.addEventListener('beforeprint',()=>{closed=Array.from(document.querySelectorAll<HTMLDetailsElement>('.portfolio-item:not([open])'));closed.forEach(d=>d.open=true)});
  window.addEventListener('afterprint',()=>{closed.forEach(d=>d.open=false);closed=[]});
</script>
