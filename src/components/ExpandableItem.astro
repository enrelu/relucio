---
interface Props { title:string; subtitle:string; year:string; summary?:string; details:string; id:string; url?:string; }
const {title,subtitle,year,summary,details,id,url}=Astro.props;
---
<article class="portfolio-record">
  <details id={id} class="portfolio-item">
    <summary><div class="portfolio-title"><h3>{title}</h3><span>{year}</span></div><p class="portfolio-subtitle">{subtitle}</p>{summary && <p class="portfolio-summary">{summary}</p>}<span class="portfolio-expand">Ver detalle <span aria-hidden="true">↓</span></span></summary>
    <div class="portfolio-details">{details.split('\n').filter(line=>line.trim()).map(line=><p>{line.trim()}</p>)}</div>
  </details>
  {url && <a class="text-link portfolio-project-link" href={url} target="_blank" rel="noopener noreferrer">Ver proyecto ↗</a>}
</article>
