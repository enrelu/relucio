---
import { localeFor, localizedPath } from '../i18n/routes';

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
const locale = localeFor(Astro.url.pathname);
const isEnglish = locale === 'en';

const content = {
  es: {
    eyebrow: 'Consultoría comercial · Empresas tecnológicas B2B',
    title: '¿Tu actividad comercial depende demasiado de la improvisación?',
    description: 'Analizo cómo vendes hoy, definimos una forma clara de trabajar y configuramos herramientas para que tu equipo ejecute con criterio compartido.',
    cta: 'Hablemos de tu negocio',
    secondary: 'Ver cómo trabajo',
    direct: 'O escríbeme directamente a'
  },
  en: {
    eyebrow: 'Sales consulting · B2B technology companies',
    title: 'Is your sales operation relying too much on guesswork?',
    description: 'I assess how you sell today, define a clear way of working, and configure practical tools so your team executes with shared criteria.',
    cta: 'Let’s talk about your business',
    secondary: 'See how I work',
    direct: 'Or email me directly at'
  }
}[isEnglish ? 'en' : 'es'];
---

<aside class="consulting-cta-box" aria-labelledby="cta-box-title">
  <div class="cta-box-inner">
    <div class="cta-box-copy">
      <p class="eyebrow">{content.eyebrow}</p>
      <h3 id="cta-box-title">{content.title}</h3>
      <p class="cta-box-desc">{content.description}</p>
      
      <div class="cta-box-actions">
        <a class="button button-primary" href={localizedPath('/contacto', locale)} data-track="cta-blog">
          {content.cta} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={localizedPath('/#metodo', locale)}>
          {content.secondary} ↓
        </a>
      </div>

      <p class="cta-box-direct">
        {content.direct} <a href="mailto:enrique@relucio.es" class="direct-email">enrique@relucio.es</a>
      </p>
    </div>
  </div>
</aside>

<style>
  .consulting-cta-box {
    margin: 48px 0 24px;
    padding: 36px 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .cta-box-copy .eyebrow {
    margin-bottom: 12px;
  }
  .cta-box-copy h3 {
    font-size: clamp(22px, 2.5vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.03em;
    font-weight: 550;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .cta-box-desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 640px;
  }
  .cta-box-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cta-box-direct {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .direct-email {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .direct-email:hover {
    color: var(--accent);
  }
  @media (max-width: 767px) {
    .consulting-cta-box {
      padding: 24px 20px;
      margin: 36px 0 20px;
    }
    .cta-box-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .cta-box-actions .button {
      width: 100%;
    }
  }
</style>
