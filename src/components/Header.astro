---
import blogMap from '../i18n/blog-map.json';
import { localeFor, localeRoutes, localizedPath } from '../i18n/routes';
const locale = localeFor(Astro.url.pathname);
const isEnglish = locale === 'en';
const alternate = localeRoutes(Astro.url.pathname);
const currentArticle = blogMap.find(post => decodeURI(Astro.url.pathname).includes('/blog/' + (isEnglish ? post.en : post.es) + '/'));
const hashMap = currentArticle ? (isEnglish ? currentArticle.anchorsEnToEs : currentArticle.anchorsEsToEn) : {};
const navigation = [
  { label: isEnglish ? 'What I offer' : 'Qué ofrezco', href: '/#oferta' },
  { label: isEnglish ? 'How I work' : 'Cómo trabajo', href: '/#metodo' },
  { label: 'Blog', href: '/blog' },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href={localizedPath("/", locale)} aria-label={isEnglish ? "Enrique Relucio, home" : "Enrique Relucio, inicio"}>
      <img src="/Logo_ER_B&W.png" alt="" width="36" height="36" class="dark:hidden" />
      <img src="/Logo_ER_White.png" alt="" width="36" height="36" class="hidden dark:block" />
      <span>Enrique Relucio</span>
    </a>
    <div class="header-controls">
      <label class="language-control"><span class="sr-only">{isEnglish ? 'Language' : 'Idioma'}</span>
        <select id="language-select" data-hash-map={JSON.stringify(hashMap)} aria-label={isEnglish ? 'Language' : 'Idioma'}>
          <option value="es" data-url={alternate.es} selected={!isEnglish}>ES</option>
          <option value="en" data-url={alternate.en} selected={isEnglish} disabled={!alternate.en}>EN</option>
        </select>
        <noscript><style>#language-select{display:none}</style><a class="text-link" href={alternate.es} lang="es" hreflang="es">ES</a>{alternate.en && <a class="text-link" href={alternate.en} lang="en" hreflang="en">EN</a>}</noscript>
      </label>
      <button id="theme-toggle" class="icon-button" type="button" aria-label={isEnglish ? "Switch to dark mode" : "Cambiar a modo oscuro"} aria-pressed="false"><svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.7 13A9 9 0 0 1 11 3.3 9 9 0 1 0 20.7 13Z" /></svg><svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg></button>
      <button id="menu-toggle" class="icon-button menu-button" type="button" aria-label={isEnglish ? "Open menu" : "Abrir menú"} aria-expanded="false" aria-controls="nav-menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
    <nav id="nav-menu" class="site-nav" aria-label={isEnglish ? "Main navigation" : "Navegación principal"}>
      {navigation.map(item => <a href={localizedPath(item.href, locale)}>{item.label}</a>)}
      <a href={localizedPath("/sobre-mi", locale)}>{isEnglish ? "About me" : "Sobre mí"}</a>
      <a class="button button-primary" href={localizedPath("/contacto", locale)}>{isEnglish ? "Let’s talk" : "Hablemos"}</a>
    </nav>
  </div>
</header>
<script>
  const english = document.documentElement.lang === 'en';
  const selector = document.getElementById('language-select') as HTMLSelectElement;
  selector?.addEventListener('change', () => {
    const option = selector.selectedOptions[0];
    const url = option?.dataset.url;
    if (!url) return;
    try { localStorage.setItem('relucio-language', selector.value); } catch {}
    let hash = location.hash;
    try { const map = JSON.parse(selector.dataset.hashMap || '{}'); const key = decodeURIComponent(hash.slice(1)); if (map[key]) hash = '#' + encodeURIComponent(map[key]); } catch {}
    location.assign(url + location.search + hash);
  });
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav-menu');
  function setMenu(open: boolean) {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? (english ? 'Close menu' : 'Cerrar menú') : (english ? 'Open menu' : 'Abrir menú'));
  }
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
  });
  const themeButton = document.getElementById('theme-toggle');
  function syncTheme() {
    const dark = document.documentElement.classList.contains('dark');
    themeButton?.setAttribute('aria-pressed', String(dark));
    themeButton?.setAttribute('aria-label', dark ? (english ? 'Switch to light mode' : 'Cambiar a modo claro') : (english ? 'Switch to dark mode' : 'Cambiar a modo oscuro'));
  }
  themeButton?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch {}
    syncTheme();
  });
  syncTheme();
</script>
<noscript><style>.menu-button{display:none!important}@media(max-width:900px){.site-header-inner{flex-wrap:wrap}.site-nav{display:flex!important;position:static!important;flex-direction:row!important;flex-wrap:wrap;width:100%;padding:0!important;border:0!important;gap:12px!important}}</style></noscript>
