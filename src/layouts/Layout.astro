---
import Header from '../components/Header.astro';
import { localeFor, localeRoutes } from '../i18n/routes';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/services.css';
import '../styles/uiux-refresh.css';
import SecurityHeaders from '../components/SecurityHeaders.astro';

interface Props {
	title: string;
	description?: string;
    showHeader?: boolean;
    wide?: boolean;
    image?: string;
    ogType?: string;
}

// 2. Le damos valor por defecto true (si no dices nada, se muestra)
const { 
    title, 
    description = Astro.url.pathname.startsWith("/en/") ? "Sales leadership and business development for B2B technology companies." : "Dirección comercial y desarrollo de negocio para empresas tecnológicas B2B.", 
    showHeader = true,
    wide = false,
    image = "/Logo_ER_B&W.png", // Fallback image for social sharing
    ogType = "website"
} = Astro.props;

const locale = localeFor(Astro.url.pathname);
const isEnglish = locale === 'en';
const alternateRoutes = localeRoutes(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
	<head>
		<SecurityHeaders />
		<meta charset="UTF-8" />
        <script is:inline>
          // Detect only at the unqualified home entry; explicit /en/ and deep links win.
          (() => {
            if (location.pathname !== '/') return;
            let saved = null;
            try { saved = localStorage.getItem('relucio-language'); } catch {}
            const preferred = saved === 'es' || saved === 'en' ? saved : (navigator.language || '').toLowerCase().startsWith('es') ? 'es' : 'en';
            if (preferred === 'en') location.replace('/en/' + location.search + location.hash);
          })();
        </script>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
		<title>{title}</title>
        <meta name="generator" content={Astro.generator} />
        {import.meta.env.VERCEL_ENV === "preview" && <meta name="robots" content="noindex, nofollow" />}
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="es" href={new URL(alternateRoutes.es, Astro.site)} />
        {alternateRoutes.en && <link rel="alternate" hreflang="en" href={new URL(alternateRoutes.en, Astro.site)} />}
        <link rel="alternate" hreflang="x-default" href={new URL(alternateRoutes.es, Astro.site)} />
        <meta property="og:locale" content={isEnglish ? 'en_US' : 'es_ES'} />
        {alternateRoutes.en && <meta property="og:locale:alternate" content={isEnglish ? 'es_ES' : 'en_US'} />}

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <!-- JSON-LD Structured Data for Personal Website -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Enrique Relucio",
            "url": "https://relucio.es",
            "image": "https://relucio.es/sobre_mi.jpg",
            "sameAs": [
                "https://www.linkedin.com/in/enriquerelucio/"
            ],
            "jobTitle": isEnglish ? "Sales leadership and business development" : "Dirección comercial y desarrollo de negocio",
            "worksFor": {
                "@type": "Organization",
                "name": "Alcorce Ciberseguridad"
            },
            "description": description
        })} />
		<script is:inline>
			const theme = (() => {
                try { const stored = localStorage.getItem('theme'); if (stored === 'dark' || stored === 'light') return stored; } catch {}
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            })();
			if (theme === 'dark') document.documentElement.classList.add('dark');
		</script>
	</head>
	<body class="site-body bg-white dark:bg-zinc-950 text-zinc-600 dark:text-zinc-400 min-h-screen selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-900">
        <a class="skip-link" href="#main-content">{isEnglish ? 'Skip to content' : 'Saltar al contenido'}</a>
        {showHeader && <Header />}
        <main id="main-content" class:list={["site-main", (Astro.url.pathname === "/" || Astro.url.pathname === "/en/") && "site-main-home", wide ? "site-main-wide" : "site-main-reading"]}>
            <slot />
        </main>
        <Footer />

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
	</body>
</html>

<style is:global>
	html {
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	::-webkit-scrollbar { width: 8px; }
	::-webkit-scrollbar-track { background: transparent; }
	::-webkit-scrollbar-thumb { background-color: #e4e4e7; border-radius: 20px; }
	.dark ::-webkit-scrollbar-thumb { background-color: #27272a; }
</style>